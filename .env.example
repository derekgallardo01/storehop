# ForwardEmail.net SMTP Configuration for scripts/send-outreach.py
# Copy this file to `.env` (which is gitignored) and fill in your generated alias password:
# https://forwardemail.net/en/my-account/domains/storehop.app/aliases

FORWARDEMAIL_PASSWORD=your_forwardemail_smtp_password_here
FORWARDEMAIL_USER=info@storehop.app
FORWARDEMAIL_FROM_NAME="Derek"
FORWARDEMAIL_SMTP_HOST=smtp.forwardemail.net
FORWARDEMAIL_SMTP_PORT=465
